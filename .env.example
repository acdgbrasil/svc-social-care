# Server
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=social_care

# OIDC multi-issuer (ADR-027/029/031 — Zitadel legado + Authentik em paralelo)
# CSV, um valor por issuer. Em produção são obrigatórias: sem elas o boot falha.
# Fallback legado (single-issuer): JWKS_URL, ZITADEL_ISSUER, ZITADEL_PROJECT_ID.
# OIDC_JWKS_URLS=https://auth.acdgbrasil.com.br/oauth/v2/keys
# OIDC_ISSUERS=https://auth.acdgbrasil.com.br
# OIDC_AUDIENCES=<project_id ou client_id>

# JWKS runtime refresh (ADR-040 — rotação de chave do IdP sem restart; opcional)
# Intervalo do refresh periódico dos JWKS, em segundos (default 600 = 10min).
# OIDC_JWKS_REFRESH_INTERVAL=600
# Cooldown entre refreshes on-demand (kid desconhecido), em segundos (default 30).
# Anti-hammering: um burst de tokens com kid inválido gera no máximo 1 fetch por janela.
# OIDC_JWKS_REFRESH_COOLDOWN=30

# CORS (ADR-045 — opt-in por allowlist; desligado sem esta variável)
# CSV de origens exatas. Sem ela, o middleware não entra na cadeia e nenhuma
# resposta leva header de CORS — que é o correto enquanto o consumidor for o BFF.
# `*` é aceito só fora de produção; em produção o boot falha.
# CORS_ALLOWED_ORIGINS=https://app.acdgbrasil.com.br,https://admin.acdgbrasil.com.br

# Rate limit (ADR-046 — token bucket por cliente, LIGADO por default)
# Desligar exige valor explícito: false | 0 | no | off.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=300
# RATE_LIMIT_WINDOW_SECONDS=60
# TRUST_PROXY: deriva o IP do cliente de X-Forwarded-For / X-Real-IP.
# SÓ ligue com um proxy que reescreve esses headers — se qualquer cliente
# alcança o serviço direto, o header é escolha de quem ataca e o limite some.
# Com `false` (default) atrás do Caddy, o balde é do proxy e é compartilhado
# por todos os usuários; o boot avisa isso no log.
# TRUST_PROXY=false

# Zitadel (Token Introspection — optional, for service accounts without role claims)
# ZITADEL_ISSUER=https://auth.acdgbrasil.com.br
# ZITADEL_INTROSPECT_CLIENT_ID=<API app client_id>
# ZITADEL_INTROSPECT_CLIENT_SECRET=<API app client_secret>
# ALLOWED_SERVICE_ACCOUNTS=<comma-separated user IDs from Zitadel>
