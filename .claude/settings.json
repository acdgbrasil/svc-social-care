{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package resolve)",
      "Bash(swift package show-dependencies:*)",
      "Bash(make deps)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make regression)",
      "Bash(make coverage)",
      "Bash(make coverage-report)",
      "Bash(./scripts/check_coverage.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)"
    ]
  }
}
